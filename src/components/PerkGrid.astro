---
import { perks } from '../data/items';
import iconsData from '../data/icons.json';

const icons = iconsData as Record<string, { path: string }>;
---
<div class="card-grid">
  {perks.map(perk => {
    const icon = icons[perk.slug];
    return (
      <article class="card" id={perk.slug}>
        <h3 class="card-title">
          {icon && <img class="card-icon" src={`/${icon.path}`} alt="" loading="lazy" />}
          <span class="pill pill-perk">{perk.name}</span>
        </h3>
        <p class="card-effect">{perk.effect}</p>
        {perk.note && <p class="card-note">{perk.note}</p>}
      </article>
    );
  })}
</div>
