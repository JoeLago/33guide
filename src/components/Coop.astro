---
import iconsData from '../data/icons.json';

interface Props {
  weapon: string;
}

const { weapon } = Astro.props;
const icons = iconsData as Record<string, { path: string }>;
const icon = icons[`${weapon}-coop`];
if (!icon) throw new Error(`Missing coop icon: ${weapon}-coop`);
const alt = `${weapon} Coop Power`;
---
<p class="coop-power-icon-row">
  <img class="entity-icon entity-icon-coop" src={`/${icon.path}`} alt={alt} loading="lazy" />
</p>
