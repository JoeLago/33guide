---
import { getEntry, render } from 'astro:content';
import GuideLayout from '../layouts/GuideLayout.astro';

const entry = await getEntry('guides', 'daggers');
if (!entry) throw new Error('daggers guide not found');
const { Content } = await render(entry);
---
<GuideLayout title={entry.data.title} description={entry.data.lead}>
  <h1>{entry.data.title}</h1>
  {entry.data.lead && <p class="page-lead">{entry.data.lead}</p>}
  <Content />
</GuideLayout>
